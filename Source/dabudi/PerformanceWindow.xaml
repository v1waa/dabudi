<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="dbdOverlay.PerformanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="dabudi — производительность" Icon="imgs/icon.ico" Width="244" Height="126" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Background="#00FFFFFF" ShowInTaskbar="False" Topmost="True" ShowActivated="False" xmlns:dbdoverlay="clr-namespace:dbdOverlay;assembly=dabudi" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Grid Margin="4" Background="#00FFFFFF">
    <UIElement.Effect>
      <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.9" Color="#DD000000" />
    </UIElement.Effect>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="66" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" />
    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" />
    <Border Grid.RowSpan="3" Grid.Column="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" />
    <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Margin="9,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
    <TextBlock Name="txtCpu" Grid.Row="0" Grid.Column="1" Text="—" Margin="12,0,4,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU" Margin="9,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
    <TextBlock Name="txtGpu" Grid.Row="1" Grid.Column="1" Text="—" Margin="12,0,4,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
    <TextBlock Grid.Row="2" Grid.Column="0" Text="RAM" Margin="9,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
    <TextBlock Name="txtRam" Grid.Row="2" Grid.Column="1" Text="—" Margin="12,0,4,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
  </Grid>
</Window>